    {
      "id": 9,
      "title": "Shipment status overview",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "targets": [
        {
          "query": "telemetry = from(bucket: v.defaultBucket)\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and contains(value: r._field, set: [\"temperature\", \"humidity\", \"door_open\", \"battery_percent\"]))\n  |> pivot(rowKey: [\"_time\", \"shipment_id\", \"device_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group(columns: [\"shipment_id\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 1)\n  |> rename(columns: {_time: \"last_seen\"})\n\nactuator = from(bucket: v.defaultBucket)\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"actuator_status\" and contains(value: r._field, set: [\"cooling_unit\", \"alarm\"]))\n  |> pivot(rowKey: [\"_time\", \"shipment_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group(columns: [\"shipment_id\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 1)\n  |> drop(columns: [\"_time\"])\n\njoin(tables: {telemetry: telemetry, actuator: actuator}, on: [\"shipment_id\"])\n  |> map(fn: (r) => ({r with overall_status: if uint(v: now()) - uint(v: r.last_seen) > uint(v: 30s) then \"OFFLINE\" else if r.temperature > 8.0 then \"CRITICAL\" else if r.door_open == 1 or r.alarm == 1 or r.battery_percent < 20.0 or r.cooling_unit == 2 then \"WARNING\" else \"NORMAL\"}))\n  |> keep(columns: [\"shipment_id\", \"device_id\", \"overall_status\", \"temperature\", \"humidity\", \"door_open\", \"battery_percent\", \"cooling_unit\", \"alarm\", \"last_seen\"])\n  |> group()\n  |> sort(columns: [\"shipment_id\"])\n  |> yield(name: \"shipment_overview\")",
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          }
        }
      ],
