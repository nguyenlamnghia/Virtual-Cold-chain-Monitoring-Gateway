# ==========================================================
#  COLD-CHAIN MONITORING — BIẾN MÔI TRƯỜNG TOÀN HỆ THỐNG
# ==========================================================

# ---------- MQTT (Mosquitto) ----------
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# ---------- InfluxDB 2.x ----------
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=hust
INFLUXDB_BUCKET=coldchain
INFLUXDB_TOKEN=coldchain-token-2026
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- Grafana ----------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ---------- API (FastAPI) ----------
API_PORT=8000

# ---------- Tham số nghiệp vụ / luật cảnh báo ----------
TELEMETRY_INTERVAL=5
TEMP_MAX=8
TEMP_MARGIN=0.1
TEMP_VIOLATION_CYCLES=3
OVERTEMP_MIN_CYCLES=5
OVERTEMP_MAX_CYCLES=8
DOOR_OPEN_CYCLES=2
BATTERY_MIN=20
OFFLINE_TIMEOUT=30

# ---------- Vận hành gateway & actuator (M2/M3 bổ sung) ----------
OFFLINE_CHECK_INTERVAL=5
EVENTS_KEEP=50
LOG_LEVEL=INFO
STATUS_HEARTBEAT=15
