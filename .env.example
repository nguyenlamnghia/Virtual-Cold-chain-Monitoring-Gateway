# ==========================================================
#  COLD-CHAIN MONITORING — BIẾN MÔI TRƯỜNG TOÀN HỆ THỐNG
#  M1 (Nguyễn Lâm Nghĩa) quản lý file này
# ==========================================================

# ---------- MQTT (Mosquitto) ----------
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# ---------- InfluxDB 2.x ----------
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=hust
INFLUXDB_BUCKET=coldchain
INFLUXDB_TOKEN=<điền-token-của-bạn>
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=<điền-mật-khẩu>

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- Grafana ----------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<điền-mật-khẩu>

# ---------- API (FastAPI) ----------
API_PORT=8000

# ---------- Tham số nghiệp vụ / luật cảnh báo ----------
TELEMETRY_INTERVAL=5
TEMP_MAX=8
TEMP_VIOLATION_CYCLES=3
DOOR_OPEN_CYCLES=2
BATTERY_MIN=20
OFFLINE_TIMEOUT=30

# ---------- Vận hành gateway & actuator (M2/M3 bổ sung) ----------
OFFLINE_CHECK_INTERVAL=5
EVENTS_KEEP=50
LOG_LEVEL=INFO
STATUS_HEARTBEAT=15
